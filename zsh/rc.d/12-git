# -*- sh -*-
# Git aliases — mirrors pwsh 12-git

# ---------------------------------------------------------------------------
# _help_print — render a man-page-style help string with ANSI colour
# ---------------------------------------------------------------------------
_help_print() {
    local esc=$'\033'
    local bold="${esc}[1m" yellow="${esc}[33m" cyan="${esc}[36m" reset="${esc}[0m"
    while IFS= read -r line; do
        if [[ "$line" =~ ^(NAME|SYNOPSIS|DESCRIPTION|OPTIONS|EXAMPLES|SEE\ ALSO)$ ]]; then
            echo "${bold}${yellow}${line}${reset}"
        elif [[ "$line" =~ ^'    '-  ]]; then
            echo "${bold}${cyan}${line}${reset}"
        else
            echo "$line"
        fi
    done
}

# ---------------------------------------------------------------------------
# Status
# ---------------------------------------------------------------------------
# In-progress operation (rebase / merge / cherry-pick / revert / am / bisect).
#
# Plain `git status` prints this prominently ("interactive rebase in progress;
# onto bf25f47"), and gstat replaces git status — so without this you lose the
# single most important thing on screen when a rebase stops on a conflict.
#
# State lives in files under the git dir; `git rev-parse --git-path` resolves
# them correctly inside worktrees, where .git is a file rather than a folder.
_git_progress_state() {
    local esc=$'\033'
    local reset="${esc}[0m" bold="${esc}[1m" yellow="${esc}[33m" gray="${esc}[90m"

    local gp label detail hint
    gp=$(git rev-parse --git-path rebase-merge 2>/dev/null)
    if [[ -d "$gp" ]]; then
        local num end head onto
        num=$(cat "$gp/msgnum" 2>/dev/null)
        end=$(cat "$gp/end" 2>/dev/null)
        head=$(cat "$gp/head-name" 2>/dev/null)
        onto=$(git rev-parse --short=7 "$(cat "$gp/onto" 2>/dev/null)" 2>/dev/null)
        [[ -f "$gp/interactive" ]] && label='REBASE -i' || label='REBASE'
        detail="${num:-?}/${end:-?}  onto ${onto}  (${head#refs/heads/})"
        hint='gitrc = continue   gitra = abort   git rebase --skip'
    else
        gp=$(git rev-parse --git-path rebase-apply 2>/dev/null)
        if [[ -d "$gp" ]]; then
            local num last head
            num=$(cat "$gp/next" 2>/dev/null)
            last=$(cat "$gp/last" 2>/dev/null)
            head=$(cat "$gp/head-name" 2>/dev/null)
            if [[ -f "$gp/applying" ]]; then
                label='AM'
                hint='git am --continue   git am --abort'
            else
                label='REBASE'
                hint='gitrc = continue   gitra = abort   git rebase --skip'
            fi
            detail="${num:-?}/${last:-?}${head:+  (${head#refs/heads/})}"
        elif [[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]]; then
            label='MERGE'
            detail="merging $(git rev-parse --short=7 MERGE_HEAD 2>/dev/null)"
            hint='git merge --continue   git merge --abort'
        elif [[ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD 2>/dev/null)" ]]; then
            label='CHERRY-PICK'
            detail="picking $(git rev-parse --short=7 CHERRY_PICK_HEAD 2>/dev/null)"
            hint='git cherry-pick --continue   git cherry-pick --abort'
        elif [[ -f "$(git rev-parse --git-path REVERT_HEAD 2>/dev/null)" ]]; then
            label='REVERT'
            detail="reverting $(git rev-parse --short=7 REVERT_HEAD 2>/dev/null)"
            hint='git revert --continue   git revert --abort'
        elif [[ -f "$(git rev-parse --git-path BISECT_LOG 2>/dev/null)" ]]; then
            label='BISECT'
            detail="$(git bisect log 2>/dev/null | grep -c '^git bisect good\|^git bisect bad') step(s) recorded"
            hint='git bisect good / bad   git bisect reset'
        else
            return 1
        fi
    fi

    echo "${bold}${yellow}${label}${reset} ${detail}"
    echo "${gray}        ${hint}${reset}"
    return 0
}

gstat() {
    local esc=$'\033'
    local reset="${esc}[0m"  bold="${esc}[1m"
    local green="${esc}[32m" red="${esc}[31m" yellow="${esc}[33m"
    local cyan="${esc}[36m"  gray="${esc}[90m"
    local up='↑' dn='↓'

    local branch revno
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || branch=$(git rev-parse --short HEAD 2>/dev/null)
    revno=$(git rev-parse --short=7 HEAD 2>/dev/null)

    local ahead behind ahead_str="" behind_str=""
    ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || true)
    behind=$(git rev-list --count 'HEAD..@{upstream}' 2>/dev/null || true)
    [[ -n "$ahead"  && "$ahead"  -gt 0 ]] && ahead_str=" ${green}${up}${ahead}${reset}"
    [[ -n "$behind" && "$behind" -gt 0 ]] && behind_str=" ${red}${dn}${behind}${reset}"

    echo "${bold}branch:${reset} ${cyan}${branch}${reset} ${gray}${revno}${reset}${ahead_str}${behind_str}"
    _git_progress_state
    echo ""

    local lines staged unstaged conflicts untracked l label
    lines=$(git status --porcelain 2>/dev/null)
    staged=$(echo "$lines"    | grep -E '^[AMDRC]'                 || true)
    unstaged=$(echo "$lines"  | grep -E '^.[MD]'                   || true)
    conflicts=$(echo "$lines" | grep -E '^(UU|AA|DD|AU|UA|DU|UD)' || true)
    untracked=$(echo "$lines" | grep -E '^\?\?'                    || true)

    if [[ -n "$staged" ]]; then
        echo "${bold}${green}Staged:${reset}"
        while IFS= read -r l; do
            case "${l:0:1}" in
                A) label="new file" ;; M) label="modified" ;;
                D) label="deleted " ;; R) label="renamed " ;;
                C) label="copied  " ;; *) label="${l:0:1}"  ;;
            esac
            echo "  ${green}${label}:${reset} ${l:3}"
        done <<< "$staged"
        echo ""
    fi

    if [[ -n "$unstaged" ]]; then
        echo "${bold}${red}Unstaged:${reset}"
        while IFS= read -r l; do
            case "${l:1:1}" in
                M) label="modified" ;; D) label="deleted " ;; *) label="${l:1:1}" ;;
            esac
            echo "  ${red}${label}:${reset} ${l:3}"
        done <<< "$unstaged"
        echo ""
    fi

    if [[ -n "$conflicts" ]]; then
        echo "${bold}${yellow}Conflicts:${reset}"
        while IFS= read -r l; do
            echo "  ${yellow}conflict:${reset} ${l:3}"
        done <<< "$conflicts"
        echo ""
    fi

    if [[ -n "$untracked" ]]; then
        echo "${bold}${gray}Untracked:${reset}"
        while IFS= read -r l; do
            echo "  ${gray}${l:3}${reset}"
        done <<< "$untracked"
        echo ""
    fi

    [[ -z "$lines" ]] && echo "${green}Nothing to commit, working tree clean${reset}"
}
