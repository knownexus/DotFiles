# Clean — confirms before permanently deleting untracked files/dirs
gclean() {
    local preview
    preview=$(git clean -fdn "$@")
    if [[ -z "$preview" ]]; then
        echo "Nothing to clean."
        return 0
    fi
    echo "This will permanently delete the following untracked files/directories:"
    echo "$preview"
    printf "Proceed with git clean -fd %s? (y/n) " "$*"
    read -r ans
    [[ "$ans" == "y" ]] && git clean -fd "$@"
}

# ---------------------------------------------------------------------------
# Push
# ---------------------------------------------------------------------------
# Force-push — confirms and shows the upstream that would be overwritten
# --force-with-lease refuses the push if the remote has commits your
# remote-tracking ref does not know about, so you cannot silently flatten
# someone else's work. --force-if-includes closes the hole in it: a plain
# lease check passes if you merely FETCHED their commits without integrating
# them, because the tracking ref then looks current. Together they mean
# "overwrite only what I have actually seen and built on".
_confirm_force_push() {
    local upstream ans rc
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
    echo "Force-push (with lease) to: ${upstream:-<no upstream configured>}"
    printf "Proceed? (y/n) "
    read -r ans
    [[ "$ans" == "y" ]] || return 1

    git push --force-with-lease --force-if-includes "$@"
    rc=$?
    if (( rc != 0 )); then
        echo ""
        echo "If this was rejected as 'stale info', the remote moved since your last"
        echo "fetch — that is the lease doing its job. Run 'gitf' and look at what"
        echo "arrived before deciding; re-running with --force would discard it."
    fi
    return $rc
}
gpf()   { _confirm_force_push "$@"; }
gitfp() { _confirm_force_push "$@"; }
gitpf() { _confirm_force_push "$@"; }

# Move the current branch's remote HEAD to <sha> (force), leaving the local
# branch where it is. Same confirm + lease as gpf.
# Usage: gpfs <sha>
gpfs() {
    local commit branch remote ref
    commit=$(git rev-parse --verify --quiet "${1}^{commit}") || { echo "Not a commit: $1"; return 1; }
    branch=$(git rev-parse --abbrev-ref HEAD)
    remote=$(git config "branch.${branch}.remote"); remote=${remote:-origin}
    ref=$(git config "branch.${branch}.merge");     ref=${ref:-refs/heads/$branch}
    _confirm_force_push "$remote" "${commit}:${ref}"
}

