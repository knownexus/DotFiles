# Reset --hard — confirms before discarding uncommitted changes
grh() {
    local dirty
    dirty=$(git status --short)
    if [[ -n "$dirty" ]]; then
        echo "This will discard the following uncommitted changes:"
        echo "$dirty"
    fi
    printf "Proceed with git reset --hard %s? (y/n) " "${1:-HEAD}"
    read -r ans
    [[ "$ans" == "y" ]] && git reset --hard "$@"
}

# Hard-reset to remote HEAD using fetch + FETCH_HEAD (works without tracking ref)
gitremote-reset() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD)
    git fetch origin "$branch"
    git reset --hard FETCH_HEAD
}
