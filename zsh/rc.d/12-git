gdf()  { git diff --color=always "$@" | less -R; }
# Side-by-side in vim instead of inline in the pager: steps through each
# changed file in turn. --no-prompt skips the "launch vimdiff? [Y/n]" per file.
# --trust-exit-code makes :cq (quit vim with an error) abort the whole run;
# without it git ignores the tool's exit code and marches through every
# remaining file regardless. :qa still moves on to the next one normally.
gdv()  { git difftool --no-prompt --trust-exit-code --tool=vimdiff "$@"; }
gdvs() { git difftool --no-prompt --trust-exit-code --tool=vimdiff --staged "$@"; }

# gs, side by side: a commit against its parent. <rev>^! is git's shorthand
# for exactly that. Merges are the exception — git shows no diff for a merge
# commit, so ^! would open nothing at all; fall back to the first parent,
# which is what you actually want to see for a merge.
gsv() {
    local rev=${1:-HEAD}
    if [ "$(git rev-list --no-walk --count --merges "$rev" 2>/dev/null)" = "1" ]; then
        print -u2 "gsv: $rev is a merge — diffing against its first parent"
        git difftool --no-prompt --trust-exit-code --tool=vimdiff "${rev}^1" "$rev"
    else
        git difftool --no-prompt --trust-exit-code --tool=vimdiff "${rev}^!"
    fi
}
gdfs() { git diff --staged --color=always "$@" | less -R; }
gdf1() { git diff HEAD~1 --color=always "$@" | less -R; }

# Bare gitb lists each branch (newest first) with its last commit date and head; args pass through
# (unalias first so a reload in a shell that still has the old alias works)
unalias gitb 2>/dev/null
gitb() {
    if (( $# )); then git branch "$@"; return; fi
    # Tab-separated fields; awk trims the subject at its first ':', sizes the name column to the
    # longest name (shrinking, min 10, to leave room for date, hash and some subject; longer names
    # overflow it, cut with '…' only if date and hash would no longer fit) and cuts subjects at
    # the window edge so nothing wraps
    git branch --sort=-committerdate --format='%(HEAD)%09%(refname:short)%09%(committerdate:format:%Y-%m-%d %H:%M)%09%(objectname:short)%09%(contents:subject)' |
        awk -F'\t' -v cols="${COLUMNS:-120}" '
            { n++; head[n] = $1; name[n] = $2; date[n] = $3; hash[n] = $4; s = $5; sub(/:.*/, "", s); subj[n] = s
              if (length($2) > maxName) maxName = length($2)
              if (length($4) > maxHash) maxHash = length($4)
              if (length(s) > maxSubj) maxSubj = length(s) }
            END {
                fixed = 2 + 1 + 16 + 1 + maxHash + 1
                w = cols - 1 - fixed - (maxSubj < 12 ? maxSubj : 12); if (w < 10) w = 10
                if (w > maxName) w = maxName
                fit = cols - 1 - fixed; if (fit < 10) fit = 10
                for (i = 1; i <= n; i++) {
                    if (length(name[i]) > fit) name[i] = substr(name[i], 1, fit - 1) "…"
                    nw = length(name[i]) > w ? length(name[i]) : w
                    avail = cols - 1 - (2 + nw + 1 + 16 + 1 + length(hash[i]) + 1)
                    s = subj[i]
                    if (length(s) > avail) s = avail > 1 ? substr(s, 1, avail - 1) "…" : ""
                    printf "%s \033[32m%-*s\033[m \033[33m%s\033[m \033[34m%s\033[m %s\n", head[i], w, name[i], date[i], hash[i], s
                }
            }'
}
