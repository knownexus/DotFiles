# Interactive rebase — integer N rebases HEAD~N; SHA/branch rebases from that ref's parent
gri() {
    local target="${1:-1}"
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        git rebase -i "HEAD~${target}"
    else
        git rebase -i "${target}^"
    fi
}

grim() {
    local target="${1:-1}"
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        git rebase -i --rebase-merges "HEAD~${target}"
    else
        git rebase -i --rebase-merges "${target}^"
    fi
}

# ---------------------------------------------------------------------------
# Interactive rebase onto main/master, origin, or this branch's own source
# ---------------------------------------------------------------------------

# Prints this repo's primary branch — main or master, whichever it actually
# has. origin/HEAD decides when it points at one of the two (it's what the
# remote itself calls primary — a develop-default repo's origin/HEAD is
# ignored); otherwise local branches are checked before origin/, or origin/
# first when called with 'origin'. Returns 1 if neither exists anywhere.
_git_primary_branch() {
    local head ns name
    local -a order=(refs/heads refs/remotes/origin)
    [[ "$1" == origin ]] && order=(refs/remotes/origin refs/heads)
    head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    case "${head#origin/}" in
        main|master) echo "${head#origin/}"; return 0 ;;
    esac
    for ns in "${order[@]}"; do
        for name in main master; do
            git show-ref --verify --quiet "$ns/$name" && { echo "$name"; return 0; }
        done
    done
    return 1
}

# True if <candidate> could be where <branch> was branched from: it resolves
# to a commit, isn't HEAD or a bare hash (neither names a branch), and isn't
# <branch> itself or its own copy on a remote — a plain tracking checkout
# records "Created from origin/<branch>", which says nothing about where the
# work actually started.
_git_is_source_candidate() {
    local branch="$1" cand="$2" remote
    [[ -z "$cand" || "$cand" == HEAD || "$cand" == "$branch" ]] && return 1
    [[ "$cand" =~ ^[0-9a-f]{7,40}$ ]] && return 1
    if [[ -n "$branch" ]]; then
        for remote in $(git remote 2>/dev/null); do
            [[ "$cand" == "$remote/$branch" ]] && return 1
        done
    fi
    git rev-parse --verify --quiet "$cand^{commit}" &>/dev/null
}

# Works out which branch the current one was created from, printing
# "<source><TAB><how>". In order:
#   1. the branch's own reflog — its oldest entry is "branch: Created from X"
#   2. if X was just HEAD (plain `git checkout -b`/`switch -c`), the HEAD
#      reflog's "checkout: moving from Y to <branch>" at that same commit
#   3. wt.default-base, then develop, then main/master — first that exists,
#      locally or on origin/
# Reflogs expire (90 days by default), so old branches land on step 3.
_git_branch_source() {
    local tab=$'\t' branch created_sha from line
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

    if [[ -n "$branch" ]]; then
        line=$(git reflog show --format='%H%x09%gs' "refs/heads/$branch" -- 2>/dev/null | tail -n 1)
        if [[ "${line#*$tab}" == "branch: Created from "* ]]; then
            created_sha="${line%%$tab*}"
            from="${line#*${tab}branch: Created from }"
            if [[ "$from" == HEAD ]]; then
                from=""
                local prefix="${created_sha}${tab}checkout: moving from " suffix=" to $branch"
                while IFS= read -r line; do
                    [[ "$line" == "$prefix"*"$suffix" ]] && from="${${line#"$prefix"}%"$suffix"}"
                done < <(git reflog show --format='%H%x09%gs' HEAD -- 2>/dev/null)
            fi
            # Tracking checkouts record the full ref (refs/remotes/origin/x).
            from="${${from#refs/heads/}#refs/remotes/}"
            if _git_is_source_candidate "$branch" "$from"; then
                printf '%s\t%s\n' "$from" "from reflog"; return 0
            fi
        fi
    fi

    local configured name ref
    configured=$(git config --get wt.default-base 2>/dev/null)
    for name in "$configured" develop "$(_git_primary_branch)"; do
        [[ -z "$name" ]] && continue
        for ref in "$name" "origin/$name"; do
            if _git_is_source_candidate "$branch" "$ref"; then
                printf '%s\t%s\n' "$ref" "fallback"; return 0
            fi
        done
    done
    return 1
}

# Prints the commit where HEAD forked off <source>. Checks both the local
# and origin/ copies of the source (whichever exist) and takes the fork point
# nearest HEAD, so a stale local develop doesn't drag its newer upstream
# commits into the rebase todo list.
_git_fork_point() {
    local src="$1" remote ref mb n best best_n
    local -a refs=("$src")
    local matched=""
    for remote in $(git remote 2>/dev/null); do
        if [[ "$src" == "$remote/"* ]]; then
            matched=1
            git show-ref --verify --quiet "refs/heads/${src#"$remote/"}" && refs+=("${src#"$remote/"}")
        fi
    done
    [[ -z "$matched" ]] && git show-ref --verify --quiet "refs/remotes/origin/$src" && refs+=("origin/$src")

    for ref in "${refs[@]}"; do
        mb=$(git merge-base HEAD "$ref" 2>/dev/null) || continue
        n=$(git rev-list --count "$mb..HEAD")
        if [[ -z "$best" ]] || (( n < best_n )); then best="$mb"; best_n="$n"; fi
    done
    [[ -n "$best" ]] && echo "$best"
}

# Interactive rebase of the current branch onto main/master, whichever this
# repo has. Always uses origin/<name> when it exists (a local main/master is
# usually stale); only falls back to the local branch if origin has no copy.
# No fetch — that's gromi.
grmi() {
    git rev-parse --git-dir >/dev/null || return 1
    local primary target
    primary=$(_git_primary_branch origin) \
        || { echo "No main or master branch found (origin/ or local) — try gitf first." >&2; return 1; }
    target="origin/$primary"
    if ! git show-ref --verify --quiet "refs/remotes/origin/$primary"; then
        target="$primary"
        echo "No 'origin/$primary' — using local '$target'"
    fi
    git rebase -i "$target" "$@"
}

# Fetch origin's main/master (whichever it has) and interactively rebase the
# current branch onto it.
gromi() {
    git rev-parse --git-dir >/dev/null || return 1
    local primary
    primary=$(_git_primary_branch origin) \
        || { echo "No main or master branch found on origin — try gitf first." >&2; return 1; }
    git fetch origin "$primary" || return 1
    git rebase -i FETCH_HEAD "$@"
}

# Interactive rebase of just this branch's own commits, from the point where
# it left its source branch — the base stays put, so the todo list is exactly
# the work done on this branch, ready to squash/reword/reorder. The source is
# worked out automatically (see _git_branch_source) or given as the first
# argument; anything after that is passed to git rebase.
grsi() {
    git rev-parse --git-dir >/dev/null || return 1
    local tab=$'\t' source how found base count
    if [[ -n "$1" && "$1" != -* ]]; then
        source=$(_wt_resolve_primary "$1"); how="given"; shift
    else
        found=$(_git_branch_source) \
            || { echo "Couldn't work out where this branch started — pass it: grsi <source-branch>" >&2; return 1; }
        source="${found%%$tab*}"; how="${found#*$tab}"
    fi
    git rev-parse --verify --quiet "$source^{commit}" &>/dev/null \
        || { echo "Unknown branch or ref: '$source'" >&2; return 1; }
    base=$(_git_fork_point "$source") \
        || { echo "No common history with '$source'." >&2; return 1; }
    count=$(git rev-list --count "$base..HEAD")
    if (( count == 0 )); then
        echo "Nothing to rebase — no commits since this branch left '$source'."
        return 0
    fi
    echo "Source: $source ($how) — $count commit(s) since $(git rev-parse --short "$base")"
    git rebase -i "$base" "$@"
}

# Rebase onto a branch found by partial name in the reflog
rebaseon() {
    local fragment="$1"
    local branch
    branch=$(git reflog show --all 2>/dev/null \
        | grep "$fragment" \
        | grep 'refs/' \
        | awk 'NR==1{print $2}' \
        | sed -e 's|refs/remotes/||' -e 's/@{.*//')
    if [[ -n "$branch" ]]; then
        git rebase "$branch"
    else
        echo "No branch matching '$fragment' found in reflog" >&2
        return 1
    fi
}
alias rebase='rebaseon'

# ---------------------------------------------------------------------------
# Reset / misc
# ---------------------------------------------------------------------------
alias gup='git reset HEAD~1'
alias gitrmc='git rm --cached'
alias ignoreme='git update-index --assume-unchanged'
alias dontignoreme='git update-index --no-assume-unchanged'

# Local-only ignore via .git/info/exclude (never committed)
localignore() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: localignore <pattern> [pattern ...]" >&2
        return 1
    fi
    local exclude
    exclude="$(git rev-parse --git-common-dir)/info/exclude"
    for pattern in "$@"; do
        echo "$pattern" >> "$exclude"
        echo "Added '$pattern' to .git/info/exclude"
    done
}

# Clear screen + status
rs() { reset; git status; }

# ---------------------------------------------------------------------------
# Update shortcuts
# ---------------------------------------------------------------------------
update() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD)
    git fetch origin "$branch"
    git rebase FETCH_HEAD
}

updated() {
    git fetch origin develop
    git rebase FETCH_HEAD
}

# ---------------------------------------------------------------------------
# Worktree helpers
# ---------------------------------------------------------------------------

# Resolves the git-dir to query worktrees from: the current repo if we're
# already inside one, or a wt-setup/wt-workspace bare dir (.git-main or
# .bare) if we're sitting at a workspace root instead — not yet inside any
# specific worktree, which is the natural place to run wt-go/wt! from.
_wt_gitdir() {
    # --git-common-dir (not --git-dir) so this always resolves to the
    # shared bare repo even when invoked from inside a specific linked
    # worktree — needed so wt-repair can correctly derive the workspace
    # root as the parent of this path.
    if git rev-parse --git-common-dir &>/dev/null; then
        git rev-parse --git-common-dir
    elif [[ -d .git-main ]]; then
        echo ".git-main"
    elif [[ -d .bare ]]; then
        echo ".bare"
    else
        return 1
    fi
}

# Returns the project root (bare or standard layout)
_wt_project_root() {
    local gitdir main
    gitdir=$(_wt_gitdir) || return 1
    main=$(git --git-dir="$gitdir" worktree list --porcelain | grep '^worktree ' | head -1 | sed 's/^worktree //')
    if [[ -z "$main" ]]; then
        pwd
    elif [[ -d "$main/.git" ]]; then
        echo "$main"
    else
        dirname "$main"
    fi
}

# Returns all worktree paths, excluding the bare storage dir itself
# (.git-main / .bare) — that's never something to wt-go/wt-done into.
# Same as _wt_paths but for an explicitly-given git-dir, so callers that
# need to operate on OTHER repos (not just cwd) — like wt-repair --all —
# don't have to cd into each one first.
_wt_paths_for() {
    local gitdir="$1"
    git --git-dir="$gitdir" worktree list --porcelain | awk '
        /^worktree / { path = $0; sub(/^worktree /, "", path); is_bare = 0; next }
        /^bare$/     { is_bare = 1; next }
        /^$/         { if (path != "" && !is_bare) print path; path = ""; next }
        END          { if (path != "" && !is_bare) print path }
    '
}

_wt_paths() {
    local gitdir
    gitdir=$(_wt_gitdir) || return 1
    _wt_paths_for "$gitdir"
}

# Navigate to a worktree by partial path name
wt-go() {
    local name="$1"
    local match
    match=$(_wt_paths | grep "$name" | head -1)
    if [[ -n "$match" ]]; then
        cd "$match"
    else
        echo "No worktree matching '$name'" >&2
        return 1
    fi
}

# List all worktrees
wt-list() {
    local gitdir
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    git --git-dir="$gitdir" worktree list
}

# Resolves 'main'/'master' to whichever of the two this repo actually uses,
# so naming either works in a repo that uses the other (main in a master-era
# repo and vice versa). Prefers the name given when both exist, checks local
# branches first then origin/, and hands back the input unchanged if neither
# exists (new repo) or if it isn't main/master at all.
# Usage: _wt_resolve_primary <branch> <git-locator...>
#   e.g. _wt_resolve_primary main --git-dir="$gitdir"
#        _wt_resolve_primary main -C "$git_root"
_wt_resolve_primary() {
    local branch="$1"; shift
    local other
    case "$branch" in
        main)   other=master ;;
        master) other=main ;;
        *)      echo "$branch"; return 0 ;;
    esac

    local ns candidate
    for ns in refs/heads refs/remotes/origin; do
        for candidate in "$branch" "$other"; do
            if git "$@" rev-parse --verify --quiet "$ns/$candidate" &>/dev/null; then
                echo "$candidate"; return 0
            fi
        done
    done
    echo "$branch"
}

# Resolves the branch wt-feature/wt-fix should branch from when no base is
# given explicitly: this repo's configured default (wt.default-base, set via
# wt-default-base below), falling back to 'develop' if never configured.
_wt_default_base() {
    local gitdir="$1" configured
    configured=$(git --git-dir="$gitdir" config --get wt.default-base 2>/dev/null)
    echo "${configured:-develop}"
}

# Get or set this repo's default base branch for wt-feature/wt-fix (stored
# as git config wt.default-base, so it lives with the repo and is shared
# across all its worktrees). Run with no argument to see the current value.
wt-default-base() {
    local branch="$1" gitdir configured
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    if [[ -n "$branch" ]]; then
        local resolved="$(_wt_resolve_primary "$branch" --git-dir="$gitdir")"
        [[ "$resolved" != "$branch" ]] && echo "'$branch' → '$resolved' (this repo's primary branch)"
        git --git-dir="$gitdir" config wt.default-base "$resolved"
        echo "wt-feature/wt-fix will now default to '$resolved' in this repo"
    else
        configured=$(git --git-dir="$gitdir" config --get wt.default-base 2>/dev/null)
        if [[ -n "$configured" ]]; then
            echo "Default base branch: $configured"
        else
            echo "Default base branch: develop (built-in default, never configured)"
        fi
    fi
}

# Create a feature/ worktree + branch
wt-feature() {
    local ticket="$1" desc="$2" base="$3"
    local root wtpath gitdir
    root=$(_wt_project_root)
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    base="${base:-$(_wt_default_base "$gitdir")}"
    local resolved="$(_wt_resolve_primary "$base" --git-dir="$gitdir")"
    [[ "$resolved" != "$base" ]] && echo "Base '$base' → '$resolved' (this repo's primary branch)"
    base="$resolved"
    wtpath="$root/feature/$ticket-$desc"
    git --git-dir="$gitdir" worktree add "$wtpath" -b "feature/$ticket-$desc" "$base"
}

# Create a fix/ worktree + branch
wt-fix() {
    local ticket="$1" desc="$2" base="$3"
    local root wtpath gitdir
    root=$(_wt_project_root)
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    base="${base:-$(_wt_default_base "$gitdir")}"
    local resolved="$(_wt_resolve_primary "$base" --git-dir="$gitdir")"
    [[ "$resolved" != "$base" ]] && echo "Base '$base' → '$resolved' (this repo's primary branch)"
    base="$resolved"
    wtpath="$root/fix/$ticket-$desc"
    git --git-dir="$gitdir" worktree add "$wtpath" -b "fix/$ticket-$desc" "$base"
}

# Check out an existing branch into a new worktree, preserving path structure
# e.g. wt-c feature/ABC-123-foo  →  <root>/feature/ABC-123-foo
wt-c() {
    local branch="$1"
    local root wtpath gitdir
    root=$(_wt_project_root)
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    local resolved="$(_wt_resolve_primary "$branch" --git-dir="$gitdir")"
    [[ "$resolved" != "$branch" ]] && echo "'$branch' → '$resolved' (this repo's primary branch)"
    branch="$resolved"
    wtpath="$root/$branch"
    git --git-dir="$gitdir" worktree add "$wtpath" "$branch"
}

# Remove a worktree and safe-delete its local branch
wt-done() {
    local name="$1"
    local match branch gitdir
    match=$(_wt_paths | grep "$name" | head -1)
    if [[ -z "$match" ]]; then echo "No worktree matching '$name'" >&2; return 1; fi
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    branch=$(git -C "$match" branch --show-current)
    git --git-dir="$gitdir" worktree remove "$match"
    [[ -n "$branch" ]] && git --git-dir="$gitdir" branch -d "$branch"
}

# Force-remove a worktree + hard-delete its branch (unmerged ok)
wt-done-f() {
    local name="$1"
    local match branch gitdir
    match=$(_wt_paths | grep "$name" | head -1)
    if [[ -z "$match" ]]; then echo "No worktree matching '$name'" >&2; return 1; fi
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    branch=$(git -C "$match" branch --show-current)
    git --git-dir="$gitdir" worktree remove --force "$match"
    [[ -n "$branch" ]] && git --git-dir="$gitdir" branch -D "$branch"
}

# Show git status for every worktree
_wt_status() {
    _wt_paths | while IFS= read -r wt; do
        echo ""
        echo "=== $wt ==="
        git -C "$wt" status --short
    done
}
alias 'wt!'='_wt_status'

# Prune stale worktree references
wt-prune() {
    local gitdir
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    git --git-dir="$gitdir" worktree prune -v
}

# Repair stale worktree links — the fix for exactly the "prunable gitdir
# file points to non-existent location" situation that comes from copying
# or syncing a wt-setup/wt-workspace repo to a different machine or path
# (e.g. Windows -> Linux, or just a different directory). With no args,
# repairs the workspace at the current directory. With --all, scans a
# directory of repos (default ~/repos) for any wt-setup/wt-workspace
# workspaces with stale links and repairs all of them.
# Worktree admin dir names under a bare git-dir (i.e. the subdirectory
# names of <gitdir>/worktrees/). For wt-setup/wt-workspace's flat layout
# (worktrees created as direct children of the workspace root), these
# match the actual worktree directory names — which is what lets
# _wt_repair_one derive the CORRECT current path itself rather than
# trusting git's own report, which for a stale entry is exactly the
# broken path being repaired. Doesn't handle wt-feature/wt-fix's nested
# feature/<x>, fix/<x> layout — git's internal admin name for those is
# just the leaf component, not the nested path.
_wt_admin_names() {
    local gitdir="$1" d
    for d in "$gitdir"/worktrees/*(N/); do
        basename "$d"
    done
}

# Repairs one workspace given its bare git-dir.
_wt_repair_one() {
    local gitdir="$1"
    local workspace_root
    workspace_root=$(cd "$(dirname "$gitdir")" && pwd)
    local -a names paths
    names=("${(@f)$(_wt_admin_names "$gitdir")}")
    if (( ${#names[@]} == 0 )); then
        echo "No worktrees found to repair."
        return 0
    fi
    local n
    for n in "${names[@]}"; do
        paths+=("$workspace_root/$n")
    done
    git --git-dir="$gitdir" worktree repair "${paths[@]}"
    echo "Repaired ${#paths[@]} worktree link(s) in $workspace_root."
}

# Repair stale worktree links — the fix for exactly the "prunable gitdir
# file points to non-existent location" situation that comes from copying
# or syncing a wt-setup/wt-workspace repo to a different machine or path
# (e.g. Windows -> Linux, or just a different directory). With no args,
# repairs the workspace at the current directory. With --all, scans a
# directory of repos (default ~/repos) for any wt-setup/wt-workspace
# workspaces with stale links and repairs all of them.
wt-repair() {
    if [[ "$1" == "--all" ]]; then
        local root="${2:-$HOME/repos}"
        local dir bare_name gitdir stale any=0
        for dir in "$root"/*/; do
            dir="${dir%/}"
            if [[ -d "$dir/.git-main" ]]; then bare_name=".git-main"
            elif [[ -d "$dir/.bare" ]]; then bare_name=".bare"
            else continue
            fi
            gitdir="$dir/$bare_name"
            stale=$(git --git-dir="$gitdir" worktree list --porcelain 2>/dev/null | grep -c '^prunable')
            if (( stale > 0 )); then
                any=1
                echo "Repairing $(basename "$dir") ($stale stale link(s))..."
                _wt_repair_one "$gitdir"
            fi
        done
        (( any )) || echo "No stale worktree links found under $root."
        return 0
    fi

    local gitdir
    gitdir=$(_wt_gitdir) || { echo "Not a git repo or worktree workspace root." >&2; return 1; }
    _wt_repair_one "$gitdir"
}

# Set up a multi-worktree workspace
# Usage: wt-setup <branch,...> [repo-name] [clone-url] [parent-path]
# Also available as wt-init (see alias below the function)
wt-setup() {
    # NOTE: never name a local var "path" — it's a special zsh parameter
    # tied to $PATH; shadowing it with a scalar empties PATH for the rest
    # of this function's scope and silently breaks every external command
    # (git included). Found the hard way — see wt-setup's own bug history.
    local branches_str="" name="" clone_url="" base_path="$(pwd)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|-branches|--branches) shift; branches_str="$1" ;;
            -n|-name|--name)         shift; name="$1" ;;
            -u|-url|--url)           shift; clone_url="$1" ;;
            -p|-path|--path)         shift; base_path="$1" ;;
            *) echo "Unknown argument: $1" >&2; return 1 ;;
        esac
        shift
    done

    if [[ -z "$branches_str" ]]; then
        echo "Usage: wt-setup -b <branch[,branch,...]> [-n name] [-u clone-url] [-p path]" >&2
        return 1
    fi

    local -a branches
    branches=("${(s:,:)branches_str}")

    local git_root workspace_dir
    if [[ -n "$clone_url" ]]; then
        local repo_name="${clone_url##*/}"; repo_name="${repo_name%.git}"
        [[ -z "$name" ]] && name="$repo_name"
        local clone_target="$base_path/$name/.git-main"

        # If workspace already has content (e.g. a previous full clone), move it into a
        # named subdirectory so it becomes part of the worktree layout rather than noise.
        local potential_workspace_dir="$base_path/$name"
        if [[ -d "$potential_workspace_dir" ]]; then
            local has_other_content
            has_other_content=$(find "$potential_workspace_dir" -mindepth 1 -maxdepth 1 ! -name '.git-main' 2>/dev/null)
            if [[ -n "$has_other_content" ]]; then
                local existing_branch=""
                if [[ -d "$potential_workspace_dir/.git" ]]; then
                    existing_branch=$(git -C "$potential_workspace_dir" branch --show-current 2>/dev/null)
                fi
                [[ -z "$existing_branch" ]] && existing_branch="original"
                local salvage_dir="$potential_workspace_dir/$existing_branch"
                echo "  Existing content found — relocating to '$existing_branch/'..."
                mkdir -p "$salvage_dir"
                find "$potential_workspace_dir" -mindepth 1 -maxdepth 1 ! -name "$existing_branch" -exec mv {} "$salvage_dir/" \;
            fi
        fi

        echo "Cloning $clone_url → $clone_target"
        git clone --bare "$clone_url" "$clone_target"
        git -C "$clone_target" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
        git -C "$clone_target" fetch --all --quiet
        git_root="$clone_target"
        workspace_dir="$base_path/$name"
    else
        git_root=$(git rev-parse --show-toplevel 2>/dev/null)
        if [[ -z "$git_root" ]]; then
            echo "Not inside a git repo. Use --url to clone one." >&2; return 1
        fi
        [[ -z "$name" ]] && name="$(basename "$git_root")"
        workspace_dir="$(dirname "$git_root")/$name"
        mkdir -p "$workspace_dir"
    fi

    echo "Workspace: $workspace_dir"
    for branch in "${branches[@]}"; do
        local resolved="$(_wt_resolve_primary "$branch" -C "$git_root")"
        if [[ "$resolved" != "$branch" ]]; then
            echo "  [$branch] → '$resolved' (this repo's primary branch)"
            branch="$resolved"
        fi
        local safe_name="${branch//\//-}"
        local wtpath="$workspace_dir/$safe_name"
        if git -C "$git_root" rev-parse --verify "$branch" &>/dev/null; then
            echo "  [$branch] existing local"
            git -C "$git_root" worktree add "$wtpath" "$branch"
        elif git -C "$git_root" rev-parse --verify "origin/$branch" &>/dev/null; then
            echo "  [$branch] tracking remote"
            git -C "$git_root" worktree add --track -b "$branch" "$wtpath" "origin/$branch"
        else
            echo "  [$branch] new branch"
            git -C "$git_root" worktree add -b "$branch" "$wtpath"
        fi
    done
}

# wt-init — alternative name for wt-setup
alias wt-init='wt-setup'

# Convert the current regular repo, in place, into the wt-setup layout:
#   <repo>/.git-main/   (the old .git, now bare)
#   <repo>/<branch>/    (the old working tree, untracked/ignored files included)
# Needs a clean tree, a checked-out branch, no linked worktrees and no
# submodules (their gitdirs hold relative paths that moving .git would break).
# Usage: wt-convert [-d|--dry-run]
wt-convert() {
    local dry_run=0
    [[ "$1" == -d || "$1" == --dry-run ]] && dry_run=1

    local root branch safe_name gitmain tmp wtdir
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    [[ -z "$root" ]] && { echo "Not inside a git repo." >&2; return 1; }

    if [[ ! -d "$root/.git" ]]; then
        echo "$root has no .git directory — already a worktree/bare layout, or a linked worktree." >&2; return 1
    fi
    if (( $(git -C "$root" worktree list --porcelain | grep -c '^worktree ') > 1 )); then
        echo "Repo has linked worktrees. Remove them (wt-done) or convert from a clean clone." >&2; return 1
    fi
    if [[ -e "$root/.gitmodules" ]]; then
        echo "Repo has submodules; moving .git would break their relative gitdir links." >&2; return 1
    fi
    branch=$(git -C "$root" branch --show-current)
    [[ -z "$branch" ]] && { echo "HEAD is detached — check out a branch first." >&2; return 1; }
    # Untracked/ignored files are fine — they move along with the tree.
    local dirty
    dirty=$(git -C "$root" status --porcelain --untracked-files=no)
    if [[ -n "$dirty" ]]; then
        echo "Tracked files have uncommitted changes. Commit or stash first:" >&2
        echo "$dirty" >&2; return 1
    fi

    safe_name="${branch//\//-}"
    gitmain="$root/.git-main"
    tmp="$root/.wt-convert"
    wtdir="$root/$safe_name"
    # $wtdir may already exist as a repo folder (e.g. branch 'docs', folder docs/) — that's fine,
    # everything gets parked in $tmp first, which frees the name.
    if [[ -e "$gitmain" || -e "$tmp" ]]; then
        echo "Name clash: '.git-main' or '.wt-convert' already exists in $root." >&2; return 1
    fi
    if (( dry_run )); then
        echo "Would convert $root to .git-main + '$safe_name/' worktree layout."
        return 0
    fi

    cd "$root" || return 1
    mv "$root/.git" "$gitmain" || return 1
    git --git-dir="$gitmain" config core.bare true

    mkdir "$tmp"
    find "$root" -mindepth 1 -maxdepth 1 ! -name .git-main ! -name .wt-convert -exec mv {} "$tmp/" \;

    # --no-checkout: the files are already here, just parked in $tmp until the worktree exists.
    if ! git --git-dir="$gitmain" worktree add --no-checkout "$wtdir" "$branch"; then
        echo "worktree add failed. Your files are parked in $tmp and the repo is at $gitmain; move them back and rename .git-main to .git (and unset core.bare) to undo." >&2
        return 1
    fi
    find "$tmp" -mindepth 1 -maxdepth 1 -exec mv {} "$wtdir/" \;
    rmdir "$tmp"
    rm -f "$gitmain/index"

    # The new worktree's index starts empty; rebuild it from HEAD (working files untouched).
    git -C "$wtdir" reset --quiet

    cd "$wtdir"
    echo "Converted. $root now holds .git-main/ and $safe_name/ — add more with wt-c / wt-feature."
}

# Workspace — clone multiple repos each with their own worktrees
# Usage: wt-workspace <path> <repo-url,...> <branch,...>
wt-workspace() {
    # NOTE: never name a local var "path" — it's a special zsh parameter
    # tied to $PATH; shadowing it empties PATH for this scope and breaks
    # every external command (see wt-setup's bug history above).
    local workspace_path="$1" repos="$2" branches="$3"
    "$HOME/.resources/scripts/new-git-workspace.sh" -p "$workspace_path" -r "$repos" -b "$branches"
}

# ---------------------------------------------------------------------------
# Reverted changes — detect and clean up changes that were later reverted
# ---------------------------------------------------------------------------

# Emit "<file>\x1f<content>\t<line>" for + or - lines in a commit's diff
# (excludes +++/--- file header lines). Content is trailing-whitespace trimmed.
_grev_diff_pairs() {
    local commit="$1" sign="$2"
    local file="" oldl=0 newl=0
    git show "$commit" | while IFS= read -r line; do
        if [[ "$line" == '+++ b/'* ]]; then
            file="${line#+++ b/}"; oldl=0; newl=0; continue
        fi
        if [[ "$line" == '@@'* ]]; then
            oldl=$(grep -oP '(?<=-)\d+' <<< "$line" | head -1)
            newl=$(grep -oP '(?<=\+)\d+' <<< "$line" | head -1)
            continue
        fi
        [[ -z "$file" ]] && continue
        (( ${#line} < 1 )) && continue
        local c1="${line:0:1}" c2="${line:1:1}"
        if [[ "$c1" == '+' && "$c2" != '+' ]]; then
            if [[ "$sign" == '+' ]]; then
                local content="${line:1}"; content="${content%"${content##*[![:space:]]}"}"
                [[ -n "$content" ]] && printf '%s\x1f%s\t%s\n' "$file" "$content" "$newl"
            fi
            ((newl++))
        elif [[ "$c1" == '-' && "$c2" != '-' ]]; then
            if [[ "$sign" == '-' ]]; then
                local content="${line:1}"; content="${content%"${content##*[![:space:]]}"}"
                [[ -n "$content" ]] && printf '%s\x1f%s\t%s\n' "$file" "$content" "$oldl"
            fi
            ((oldl++))
        else
            ((oldl++)); ((newl++))
        fi
    done
}

# Find changes made in commit A that were undone in commit B (whole-diff content compare).
# Usage: grev <commit-a> <commit-b>
grev() {
    local commitA="$1" commitB="$2"
    if [[ -z "$commitA" || -z "$commitB" ]]; then
        echo "Usage: grev <commit-a> <commit-b>" >&2
        return 1
    fi
    local shaA shaB
    shaA=$(git rev-parse --short "$commitA" 2>/dev/null)
    shaB=$(git rev-parse --short "$commitB" 2>/dev/null)
    if [[ -z "$shaA" ]]; then echo "Could not resolve commit: $commitA" >&2; return 1; fi
    if [[ -z "$shaB" ]]; then echo "Could not resolve commit: $commitB" >&2; return 1; fi

    local esc=$'\033' reset yellow red green gray
    reset="${esc}[0m"; yellow="${esc}[33m"; red="${esc}[31m"; green="${esc}[32m"; gray="${esc}[90m"

    echo ""
    echo "${gray}A = $shaA  ($commitA)${reset}"
    echo "${gray}B = $shaB  ($commitB)${reset}"
    echo ""

    local aAdded aRemoved bAdded bRemoved
    aAdded=$(git show "$commitA" | grep -E '^\+[^+]' | cut -c2- | sed 's/[[:space:]]*$//' | grep -v '^$' | sort -u)
    aRemoved=$(git show "$commitA" | grep -E '^-[^-]' | cut -c2- | sed 's/[[:space:]]*$//' | grep -v '^$' | sort -u)
    bAdded=$(git show "$commitB" | grep -E '^\+[^+]' | cut -c2- | sed 's/[[:space:]]*$//' | grep -v '^$' | sort -u)
    bRemoved=$(git show "$commitB" | grep -E '^-[^-]' | cut -c2- | sed 's/[[:space:]]*$//' | grep -v '^$' | sort -u)

    local reverted readded found=0
    reverted=$(comm -12 <(echo "$aAdded") <(echo "$bRemoved"))
    readded=$(comm -12 <(echo "$aRemoved") <(echo "$bAdded"))

    if [[ -n "$reverted" ]]; then
        found=1
        echo "${yellow}A added these lines — B then removed them:${reset}"
        while IFS= read -r l; do echo "  ${red}- ${l}${reset}"; done <<< "$reverted"
        echo ""
    fi

    if [[ -n "$readded" ]]; then
        found=1
        echo "${yellow}A removed these lines — B then re-added them:${reset}"
        while IFS= read -r l; do echo "  ${green}+ ${l}${reset}"; done <<< "$readded"
        echo ""
    fi

    if [[ "$found" -eq 0 ]]; then
        echo "${gray}No changes from $shaA appear to be undone in $shaB.${reset}"
    fi
}

# Rewrite commit A to remove changes that commit B later undid.
# Usage: grev-clean <commitA> <commitB> [--dry-run]
grev-clean() {
    local commitA="$1" commitB="$2" dry_run=0
    [[ "$3" == "--dry-run" || "$3" == "-n" ]] && dry_run=1
    if [[ -z "$commitA" || -z "$commitB" ]]; then
        echo "Usage: grev-clean <commitA> <commitB> [--dry-run]" >&2
        return 1
    fi

    # All loop-scoped locals are declared once here (not re-declared inside
    # loops) — zsh emits a stray "name=value" line to stdout when a bare
    # `local` is re-declared across loop iterations.
    local shaA shaB shortA shortB git_root
    local esc reset yellow cyan red green gray
    local key line_no f ans seq_editor prev_seq_editor rebase_ok
    local full_path parent_raw pi cl cl_trim pl pl_trim
    local prev_git_editor continue_exit final_exit cf l trimmed matched
    local -a all_files lines kept restore_contents parent result conflicted to_auto unexpected

    shaA=$(git rev-parse "$commitA" 2>/dev/null)
    shaB=$(git rev-parse "$commitB" 2>/dev/null)
    shortA=$(git rev-parse --short "$commitA" 2>/dev/null)
    shortB=$(git rev-parse --short "$commitB" 2>/dev/null)
    if [[ -z "$shaA" ]]; then echo "Cannot resolve: $commitA" >&2; return 1; fi
    if [[ -z "$shaB" ]]; then echo "Cannot resolve: $commitB" >&2; return 1; fi

    if [[ -n "$(git status --porcelain)" ]]; then
        echo "Working tree is not clean. Stash or commit changes first." >&2
        return 1
    fi

    git_root=$(git rev-parse --show-toplevel)

    esc=$'\033'
    reset="${esc}[0m"; yellow="${esc}[33m"; cyan="${esc}[36m"; red="${esc}[31m"; green="${esc}[32m"; gray="${esc}[90m"

    typeset -A a_added a_removed b_added b_removed
    while IFS=$'\t' read -r key line_no; do a_added[$key]=$line_no;   done < <(_grev_diff_pairs "$shaA" '+')
    while IFS=$'\t' read -r key line_no; do a_removed[$key]=$line_no; done < <(_grev_diff_pairs "$shaA" '-')
    while IFS=$'\t' read -r key line_no; do b_added[$key]=$line_no;   done < <(_grev_diff_pairs "$shaB" '+')
    while IFS=$'\t' read -r key line_no; do b_removed[$key]=$line_no; done < <(_grev_diff_pairs "$shaB" '-')

    typeset -A to_strip to_restore
    for key in "${(@k)a_added}";   do [[ -n "${b_removed[$key]}" ]] && to_strip[$key]="${a_added[$key]}";     done
    for key in "${(@k)a_removed}"; do [[ -n "${b_added[$key]}"   ]] && to_restore[$key]="${a_removed[$key]}"; done

    if (( ${#to_strip} == 0 && ${#to_restore} == 0 )); then
        echo "No redundant changes found between $shortA and $shortB."
        return 0
    fi

    typeset -A files_set
    for key in "${(@k)to_strip}" "${(@k)to_restore}"; do files_set[${key%%$'\x1f'*}]=1; done
    all_files=("${(@k)files_set}")

    echo ""
    echo "${yellow}Changes to remove from $shortA :${reset}"
    echo ""
    for f in "${all_files[@]}"; do
        echo "${cyan}  $f${reset}"
        for key in "${(@k)to_strip}"; do
            [[ "${key%%$'\x1f'*}" == "$f" ]] || continue
            printf "    ${red}- L%-5s %s${reset}\n" "${to_strip[$key]}" "${key#*$'\x1f'}"
        done
        for key in "${(@k)to_restore}"; do
            [[ "${key%%$'\x1f'*}" == "$f" ]] || continue
            printf "    ${green}+ L%-5s %s${reset}\n" "${to_restore[$key]}" "${key#*$'\x1f'}"
        done
    done
    echo ""

    if (( dry_run )); then
        echo "${gray}Dry run — no changes made.${reset}"
        return 0
    fi

    printf "Rewrite commit %s to remove these changes? (y/n) " "$shortA"
    read -r ans
    if [[ "$ans" != "y" ]]; then echo "Aborted."; return 1; fi

    seq_editor=$(mktemp)
    cat > "$seq_editor" <<SCRIPT
#!/bin/sh
sed -i -E 's/^pick (${shaA:0:7}[0-9a-f]*)(.*)/edit \1\2/' "\$1"
SCRIPT
    chmod +x "$seq_editor"

    prev_seq_editor="$GIT_SEQUENCE_EDITOR"
    export GIT_SEQUENCE_EDITOR="$seq_editor"
    rebase_ok=1
    git rebase -i "${shaA}^" || rebase_ok=0
    export GIT_SEQUENCE_EDITOR="$prev_seq_editor"
    command rm -f "$seq_editor"   # bypass the trash-aware rm() — this is real temp-file cleanup

    if (( ! rebase_ok )); then
        echo "Rebase failed — run 'git rebase --abort' to recover." >&2
        return 1
    fi

    for f in "${all_files[@]}"; do
        full_path="$git_root/$f"
        if [[ ! -f "$full_path" ]]; then
            echo "File not found in working tree: $f — skipping" >&2
            continue
        fi

        lines=("${(@f)"$(<"$full_path")"}")

        if (( ${#to_strip} )); then
            kept=()
            for l in "${lines[@]}"; do
                trimmed="${l%"${l##*[![:space:]]}"}"
                matched=0
                for key in "${(@k)to_strip}"; do
                    [[ "${key%%$'\x1f'*}" == "$f" ]] || continue
                    [[ "$trimmed" == "${key#*$'\x1f'}" ]] && { matched=1; break }
                done
                (( matched )) || kept+=("$l")
            done
            lines=("${kept[@]}")
        fi

        if (( ${#to_restore} )); then
            restore_contents=()
            for key in "${(@k)to_restore}"; do
                [[ "${key%%$'\x1f'*}" == "$f" ]] || continue
                restore_contents+=("${key#*$'\x1f'}")
            done
            parent_raw=$(git show "HEAD^:$f" 2>/dev/null)
            if [[ -n "$parent_raw" ]]; then
                parent=("${(@f)parent_raw}")
                result=()
                pi=1
                for cl in "${lines[@]}"; do
                    cl_trim="${cl%"${cl##*[![:space:]]}"}"
                    while (( pi <= ${#parent[@]} )); do
                        pl="${parent[pi]}"
                        pl_trim="${pl%"${pl##*[![:space:]]}"}"
                        [[ "$pl_trim" == "$cl_trim" ]] && break
                        (( ${restore_contents[(Ie)$pl_trim]} )) && result+=("$pl")
                        ((pi++))
                    done
                    result+=("$cl")
                    (( pi <= ${#parent[@]} )) && ((pi++))
                done
                while (( pi <= ${#parent[@]} )); do
                    pl="${parent[pi]}"
                    pl_trim="${pl%"${pl##*[![:space:]]}"}"
                    (( ${restore_contents[(Ie)$pl_trim]} )) && result+=("$pl")
                    ((pi++))
                done
                lines=("${result[@]}")
            else
                echo "Could not read parent state of $f — removals not restored" >&2
            fi
        fi

        printf '%s\n' "${lines[@]}" > "$full_path"
        git add "$f"
    done

    git commit --amend --no-edit
    if (( $? != 0 )); then
        if git diff --cached --quiet HEAD^ 2>/dev/null; then
            echo "" >&2
            echo "$shortA's changes are now fully cancelled out by $shortB — amending would leave it empty." >&2
            echo "Run one of:" >&2
            echo "  git commit --amend --allow-empty --no-edit && git rebase --continue   # keep an empty marker commit" >&2
            echo "  git rebase --skip                                                      # drop $shortA entirely" >&2
            echo "  git rebase --abort                                                     # give up, restore original history" >&2
        else
            echo "Amend failed — run 'git rebase --abort' to recover." >&2
        fi
        return 1
    fi

    prev_git_editor="$GIT_EDITOR"
    export GIT_EDITOR=true
    git rebase --continue
    continue_exit=$?
    export GIT_EDITOR="$prev_git_editor"

    if (( continue_exit != 0 )); then
        conflicted=("${(@f)"$(git diff --name-only --diff-filter=U 2>/dev/null)"}")
        conflicted=("${(@)conflicted:#}")   # drop the spurious empty element (@f) leaves when there's no output
        to_auto=(); unexpected=()
        for cf in "${conflicted[@]}"; do
            if (( ${all_files[(Ie)$cf]} )); then to_auto+=("$cf"); else unexpected+=("$cf"); fi
        done

        if (( ${#unexpected[@]} )); then
            echo ""
            echo "Unexpected conflicts in: ${(j:, :)unexpected}. Resolve manually then run 'git rebase --continue'." >&2
            return 1
        fi
        if (( ${#to_auto[@]} == 0 )); then
            echo ""
            echo "Rebase --continue failed with no detectable conflicts. Run 'git rebase --abort' to recover." >&2
            return 1
        fi

        for cf in "${to_auto[@]}"; do
            git checkout --theirs -- "$cf"
            git add "$cf"
        done

        export GIT_EDITOR=true
        git rebase --continue
        final_exit=$?
        export GIT_EDITOR="$prev_git_editor"

        if (( final_exit != 0 )); then
            echo ""
            echo "Rebase still has conflicts after auto-resolution. Resolve manually then run 'git rebase --continue'." >&2
            return 1
        fi
    fi

    echo ""
    echo "${green}Done — commit $shortA has been cleaned up.${reset}"
}

# Scan a commit range for changes that were later reverted in a non-adjacent commit.
# Usage: grev-scan [<range>]
grev-scan() {
    local range="$1"
    local base

    # All loop-scoped locals are declared once here (not re-declared inside
    # loops) — zsh emits a stray "name=value" line to stdout when a bare
    # `local` is re-declared across loop iterations.
    local min_len=10
    local sha date subject key content i n a b
    local ei rest esign eline opposite ej rest2 esign2 gkey ftype
    local esc reset yellow cyan red green gray
    local orig_idx rev_idx rfile f rrest rcontent rtype rline rec
    local -a shas dates subjects group_order events sorted_groups records file_order frecords

    if [[ -z "$range" ]]; then
        base=$(git merge-base HEAD develop 2>/dev/null)
        if [[ -n "$base" ]]; then range="$base..HEAD"; else range="HEAD~20..HEAD"; fi
    fi

    echo "Scanning $range for redundant changes..." >&2

    # Single streamed `git log -p` over the whole range (rather than a
    # separate `git show` per commit per direction) — this is the only part
    # of the range-scanning path whose cost grows with the number of commits,
    # so it's worth keeping to one subprocess instead of 2*N.
    typeset -A index  # key: file\x1fcontent -> " idx:sign:line idx:sign:line ..."
    local cidx=0 line file oldl newl c1 c2
    file=""; oldl=0; newl=0
    while IFS= read -r line; do
        if [[ "$line" == 'COMMIT:'* ]]; then
            rest="${line#COMMIT:}"
            sha="${rest%%:*}"; rest="${rest#*:}"
            date="${rest%%:*}"; subject="${rest#*:}"
            ((cidx++))
            shas+=("$sha"); dates+=("$date"); subjects+=("$subject")
            file=""; oldl=0; newl=0
            continue
        fi
        if [[ "$line" == '+++ b/'* ]]; then
            file="${line#+++ b/}"; oldl=0; newl=0; continue
        fi
        if [[ "$line" == '@@'* ]]; then
            oldl=$(grep -oP '(?<=-)\d+' <<< "$line" | head -1)
            newl=$(grep -oP '(?<=\+)\d+' <<< "$line" | head -1)
            continue
        fi
        [[ -z "$file" || $cidx -eq 0 ]] && continue
        (( ${#line} < 1 )) && continue
        c1="${line:0:1}"; c2="${line:1:1}"
        if [[ "$c1" == '+' && "$c2" != '+' ]]; then
            content="${line:1}"; content="${content%"${content##*[![:space:]]}"}"
            if (( ${#content} >= min_len )); then
                key="${file}"$'\x1f'"${content}"
                index[$key]+=" ${cidx}:+:${newl}"
            fi
            ((newl++))
        elif [[ "$c1" == '-' && "$c2" != '-' ]]; then
            content="${line:1}"; content="${content%"${content##*[![:space:]]}"}"
            if (( ${#content} >= min_len )); then
                key="${file}"$'\x1f'"${content}"
                index[$key]+=" ${cidx}:-:${oldl}"
            fi
            ((oldl++))
        else
            ((oldl++)); ((newl++))
        fi
    done < <(git log -p --format='COMMIT:%H:%ad:%s' --date=short --reverse "$range" 2>/dev/null)

    if (( ${#shas[@]} == 0 )); then
        echo "No commits found in range '$range'." >&2
        return 0
    fi

    typeset -A groups  # key: origIdx|revIdx -> "\x01file\x1fcontent\x1ftype\x1fline ..."

    for key in "${(@k)index}"; do
        content="${key#*$'\x1f'}"
        events=(${=index[$key]})
        n=${#events[@]}
        for (( a=1; a<=n; a++ )); do
            ei="${events[a]%%:*}"; rest="${events[a]#*:}"
            esign="${rest%%:*}"; eline="${rest#*:}"
            [[ "$esign" == "+" ]] && opposite="-" || opposite="+"
            for (( b=a+1; b<=n; b++ )); do
                ej="${events[b]%%:*}"; rest2="${events[b]#*:}"
                esign2="${rest2%%:*}"
                if [[ "$esign2" == "$opposite" && "$ej" != "$ei" ]]; then
                    gkey="${ei}|${ej}"
                    [[ "$esign" == "+" ]] && ftype="AddedThenReverted" || ftype="RemovedThenRestored"
                    [[ -z "${groups[$gkey]}" ]] && group_order+=("$gkey")
                    groups[$gkey]+=$'\x01'"${key%%$'\x1f'*}"$'\x1f'"${content}"$'\x1f'"${ftype}"$'\x1f'"${eline}"
                    break
                fi
            done
        done
    done

    if (( ${#group_order[@]} == 0 )); then
        echo "No redundant changes found in $range."
        return 0
    fi

    sorted_groups=($(printf '%s\n' "${group_order[@]}" | sort -t'|' -k1,1n))

    esc=$'\033'
    reset="${esc}[0m"; yellow="${esc}[33m"; cyan="${esc}[36m"; red="${esc}[31m"; green="${esc}[32m"; gray="${esc}[90m"

    echo ""
    echo "${yellow}Redundant changes in $range :${reset}"

    for gkey in "${sorted_groups[@]}"; do
        orig_idx="${gkey%%|*}"; rev_idx="${gkey#*|}"
        echo ""
        echo "  Original : ${shas[orig_idx]:0:8}  ${dates[orig_idx]}  ${subjects[orig_idx]}"
        echo "  Reverted : ${shas[rev_idx]:0:8}  ${dates[rev_idx]}  ${subjects[rev_idx]}"
        echo ""

        records=("${(@ps:\x01:)groups[$gkey]}")
        records=("${records[@]:1}")

        typeset -A by_file
        file_order=()
        for rec in "${records[@]}"; do
            rfile="${rec%%$'\x1f'*}"
            [[ -z "${by_file[$rfile]}" ]] && file_order+=("$rfile")
            by_file[$rfile]+=$'\x01'"$rec"
        done

        for f in "${file_order[@]}"; do
            echo "    ${cyan}$f${reset}"
            frecords=("${(@ps:\x01:)by_file[$f]}")
            frecords=("${frecords[@]:1}")
            for rec in "${frecords[@]}"; do
                rrest="${rec#*$'\x1f'}"
                rcontent="${rrest%%$'\x1f'*}"
                rrest="${rrest#*$'\x1f'}"
                rtype="${rrest%%$'\x1f'*}"
                rline="${rrest#*$'\x1f'}"
                if [[ "$rtype" == "AddedThenReverted" ]]; then
                    printf "      ${red}- L%-5s %s${reset}\n" "$rline" "$rcontent"
                else
                    printf "      ${green}+ L%-5s %s${reset}\n" "$rline" "$rcontent"
                fi
            done
        done
    done

    echo ""
    echo "${gray}Tip: grev-clean <original-sha> <revert-sha> to strip redundant changes from the original commit.${reset}"
}

# ---------------------------------------------------------------------------
# fix-fetch-refspecs — add missing fetch refspecs to all local repos
# ---------------------------------------------------------------------------
fix-fetch-refspecs() {
    local root="${1:-$HOME/repos}"
    local dir fetch
    for dir in "$root"/*/; do
        [[ -d "$dir/.git" ]] || continue
        fetch=$(git -C "$dir" config --get-all remote.origin.fetch 2>/dev/null || true)
        if [[ -z "$fetch" ]]; then
            echo "Fixing: $(basename "$dir")"
            git -C "$dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
            git -C "$dir" remote update
        fi
    done
}

# ---------------------------------------------------------------------------
# repos-status — scan a directory of repos and report which need attention
# (uncommitted changes and/or commits not yet pushed to their upstream)
# ---------------------------------------------------------------------------
repos-status() {
    local root="${1:-$HOME/repos}"
    local esc=$'\033' reset yellow red green gray
    reset="${esc}[0m"; yellow="${esc}[33m"; red="${esc}[31m"; green="${esc}[32m"; gray="${esc}[90m"

    local dir name dirty dirty_count ahead any_attention=0
    local -a parts
    for dir in "$root"/*/; do
        git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null || continue
        name=$(basename "$dir")
        dirty=$(git -C "$dir" status --porcelain 2>/dev/null)
        dirty_count=0
        [[ -n "$dirty" ]] && dirty_count=$(wc -l <<< "$dirty")
        ahead=$(git -C "$dir" rev-list --count '@{upstream}..HEAD' 2>/dev/null)
        [[ -z "$ahead" ]] && ahead=0

        parts=()
        (( dirty_count > 0 )) && parts+=("${red}${dirty_count} uncommitted${reset}")
        (( ahead > 0 )) && parts+=("${yellow}${ahead} unpushed${reset}")

        if (( ${#parts[@]} > 0 )); then
            any_attention=1
            echo "  ${name}: ${(j:, :)parts}"
        fi
    done

    (( any_attention )) || echo "${green}All repos under $root are clean and pushed.${reset}"
}
