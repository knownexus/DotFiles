# -*- sh -*-

# Useful variables for our ZSH environment

test "x$HOSTNAME" = "x" && HOSTNAME=$(hostname)
export HOSTNAME

test "x$VISUAL" = "x" && VISUAL=vim
export VISUAL

test "x$EDITOR" = "x" && EDITOR=$VISUAL
export EDITOR

# ---------------------------------------------------------------------------
# Repo root alias — displayed in the prompt instead of the full path.
# Example: REPO_ROOT=$HOME/repos  REPO_SYMBOL='#'
# Prompt will show:  #/DriveFurtherAPI/develop  instead of  ~/repos/DriveFurtherAPI/develop
# Set either to empty to disable.
# ---------------------------------------------------------------------------
REPO_ROOT="${HOME}/repos"
REPO_SYMBOL='#'
export REPO_ROOT REPO_SYMBOL

# ---------------------------------------------------------------------------
# Claude API model selection (used by scripts that call the Claude API)
# API key should be set as a shell env var outside of version control:
#   export ANTHROPIC_API_KEY='sk-ant-...'
# ---------------------------------------------------------------------------
CLAUDE_MODEL='claude-sonnet-4-6'
CLAUDE_MODEL_FAST='claude-haiku-4-5-20251001'
export CLAUDE_MODEL CLAUDE_MODEL_FAST

# ---------------------------------------------------------------------------
# less — vim-flavoured keys and defaults.
#
# LESSKEYIN points straight at the repo (less 582+ reads source format), so
# editing shared/less/lesskey takes effect on the next pager with nothing to
# redeploy. ~/.resources is the symlink to this repo's zsh/ directory, so
# ../shared resolves to the repo root. Older builds need the compiled ~/.less,
# which bootstrap.sh produces when the lesskey command is available.
# LESS itself is also set in the lesskey file's #env section; this is the
# fallback for the compiled path, where #env is baked in at compile time.
# ---------------------------------------------------------------------------
LESSKEYIN="${HOME}/.resources/../shared/less/lesskey"
test -f "$LESSKEYIN" && export LESSKEYIN || unset LESSKEYIN
test -f "${HOME}/.less" && export LESSKEY="${HOME}/.less"
test "x$LESS" = "x" && LESS="-R -i -j4 --incsearch"
export LESS

# ---------------------------------------------------------------------------
# Colorized man pages via bat, if installed — falls back to the default
# pager otherwise.
# ---------------------------------------------------------------------------
if (( ${+commands[bat]} )); then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
fi
