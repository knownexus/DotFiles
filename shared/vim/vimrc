" ===========================================================================
" Cross-platform vimrc — deployed to ~/.vimrc by bootstrap.sh (Linux/macOS)
" and bootstrap.ps1 / setup.ps1 (Windows).
"
" KEEP THIS FILE LF-ONLY. Unix vim does not strip carriage returns from a
" vimrc, so a CRLF copy fails on every single line (E474/E488/E539...).
" .gitattributes in this directory pins it to LF on checkout.
" ===========================================================================

set nocompatible

" Having a ~/.vimrc stops vim loading its own defaults.vim, so everything
" that file would have given us has to be set explicitly below.

" --- Encoding --------------------------------------------------------------
set encoding=utf-8
scriptencoding utf-8
set fileformats=unix,dos

" --- Display ---------------------------------------------------------------
set background=dark
set number
set ruler
set laststatus=2
set showcmd
set showmatch
set wildmenu
set wildmode=longest:full,full
set scrolloff=8
set sidescrolloff=8
set cursorline
" cursorline is one of vim's biggest redraw costs: it repaints the full width
" of the line on every cursor move, which on a wide terminal with syntax
" highlighting is very noticeable. cursorlineopt=number keeps the useful part
" (the highlighted line number) and drops the full-width fill.
if exists('&cursorlineopt')
    set cursorlineopt=number
endif
set splitright
set splitbelow
set display=lastline
set lazyredraw
set ttyfast

" Stop syntax highlighting very long lines. Vim highlights to the end of a
" line however long it is, and a few 2000-character lines (minified output, a
" long attribute list, a big string literal) are enough to make scrolling
" crawl. Nothing useful lives past column 300 on screen anyway.
set synmaxcol=300

syntax enable
filetype plugin indent on

" True colour where the terminal actually supports it, 256-colour otherwise.
" Windows Terminal / ConHost on Win10+ and mintty both handle it; a bare
" TERM=xterm over ssh often does not, and forcing it there washes colours out.
if has('termguicolors') && (has('win32') || $COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
    set termguicolors
else
    set t_Co=256
endif
highlight CursorLine cterm=NONE ctermbg=237 guibg=#3a3a3a

" --- Indentation -----------------------------------------------------------
" tabstop/softtabstop/shiftwidth all agree, so Tab, >> and autoindent move by
" the same amount. filetype indent (above) replaces the old smartindent,
" which mis-indents Python, YAML and anything non-C-like.
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set autoindent
set shiftround

" --- Editing ---------------------------------------------------------------
set backspace=indent,eol,start
set history=1000
set mouse=a
" One wheel notch scrolls 3 lines by default, and each notch forces a redraw.
" When redraws cannot keep up the events queue and the view keeps sliding
" after you stop scrolling; one line per notch cuts that overshoot by two
" thirds. (:set mouse= drops wheel handling entirely — then the terminal
" scrolls its own buffer, which is instant but loses vim's scrollback.)
" exists('&name'), not has('patch-...'): a build can report a version and
" still not have the option (a vimrc error costs a 2-second warning delay on
" EVERY startup, which with one vim per file under gdv/gsv is brutal).
if exists('&mousescroll')
    set mousescroll=ver:1,hor:2
endif
set hidden
set confirm
set nrformats-=octal
" Let blockwise visual select past the end of short lines, so Ctrl-V + A
" appends on every line in the block instead of silently skipping the ones
" that end before the block does.
set virtualedit=block

" Diff mode: split vertically (side by side, not stacked), keep the two sides
" aligned with filler lines, ignore pure whitespace-change noise, and use the
" internal histogram algorithm, which lines hunks up far better than the
" default on real code.
set diffopt=filler,vertical,closeoff
" Blank filler rows instead of a wall of dashes where the other side has lines.
set fillchars=vert:\ ,fold:\ ,diff:\ 
" Values, not an option name — an old build accepts 'diffopt' but rejects
" these, so fail quietly rather than erroring out of the rest of this file.
silent! set diffopt+=internal,algorithm:histogram,indent-heuristic

" --- Search ----------------------------------------------------------------
" smartcase only does anything with ignorecase on: together they give
" case-insensitive search until the pattern contains a capital.
set incsearch
set hlsearch
set ignorecase
set smartcase

" --- Clipboard -------------------------------------------------------------
" unnamedplus is the X11/Wayland CLIPBOARD selection (what Ctrl+V pastes);
" unnamed is the * register, which is what Windows and macOS use.
if has('clipboard')
    if has('unnamedplus')
        set clipboard=unnamedplus
    else
        set clipboard=unnamed
    endif
endif

" --- Undo ------------------------------------------------------------------
" undofile silently does nothing if undodir does not exist, so create it.
let s:undodir = expand('~/.vim/undodir')
if !isdirectory(s:undodir)
    call mkdir(s:undodir, 'p', 0700)
endif
let &undodir = s:undodir
set undofile
set undolevels=1000

" --- Cursor shape ----------------------------------------------------------
let &t_SI = "\e[6 q"        " thin line in insert mode
let &t_EI = "\e[2 q"        " block in normal mode

" --- Leader ----------------------------------------------------------------
" Must be set before ANY <leader> mapping is defined — vim expands <leader> to
" whatever mapleader is at definition time, so a later assignment silently
" leaves earlier mappings bound to the old leader (the default backslash).
let mapleader = " "

" --- Plugins ---------------------------------------------------------------
" Native vim 8 packages, loaded from this repo rather than ~/.vim, so there is
" one copy and it travels with the dotfiles. Packages under pack/*/start are
" sourced after this file, so setting packpath here is enough.
let s:vimrc_dir = fnamemodify(resolve(expand('<sfile>:p')), ':h')
execute 'set packpath^=' . fnameescape(s:vimrc_dir)

" vim-visual-multi: live multi-cursor editing — unlike a block insert, every
" cursor echoes what you type as you type it, no Esc needed to see the result.
"   <C-n>        select the word under the cursor, again for the next match
"   <C-Down/Up>  add a cursor straight down / up (the block-insert equivalent)
"   <space>m     select every occurrence of the word under the cursor
"   <Tab>        switch between cursor and extend mode
"   <Esc>        back to one cursor
let g:VM_mouse_mappings   = 1
let g:VM_show_warnings    = 0
let g:VM_silent_exit      = 1
let g:VM_maps             = {}
let g:VM_maps['Find Under']         = '<C-n>'
let g:VM_maps['Find Subword Under'] = '<C-n>'
let g:VM_maps['Select Cursor Down'] = '<C-Down>'
let g:VM_maps['Select Cursor Up']   = '<C-Up>'
nmap <silent> <leader>m <Plug>(VM-Select-All)

" --- Cheatsheet ------------------------------------------------------------
" The viewer (folding, filtering, highlighting) lives in cheatsheet.vim next
" to this file; cheatsheet.txt next to that holds the content.
if filereadable(s:vimrc_dir . '/cheatsheet.vim')
    execute 'source ' . fnameescape(s:vimrc_dir . '/cheatsheet.vim')
endif

" --- Redraw performance tools ----------------------------------------------
if filereadable(s:vimrc_dir . '/perf.vim')
    execute 'source ' . fnameescape(s:vimrc_dir . '/perf.vim')
endif

" --- Side-by-side git diff -------------------------------------------------
if filereadable(s:vimrc_dir . '/gitdiff.vim')
    execute 'source ' . fnameescape(s:vimrc_dir . '/gitdiff.vim')
endif

" --- Mappings --------------------------------------------------------------
nnoremap <leader>w :write<CR>
nnoremap <leader>q :quit<CR>
nnoremap <leader>h :nohlsearch<CR>
nnoremap <silent> <leader>d :GitDiff<CR>
" Cheatsheet: F1 is one keypress and already means "help" everywhere, so it
" is the primary binding (vim's own F1 -> :help is remapped away). <space>c is
" the mnemonic alternative for keyboards that bury the function row.
nnoremap <silent> <F1>        :call ToggleCheatsheet()<CR>
xnoremap <silent> <F1>   <Esc>:call ToggleCheatsheet()<CR>
inoremap <silent> <F1>   <C-o>:call ToggleCheatsheet()<CR>
" vim treats <Help> as a second name for the same key and maps it to :help
" independently, so it has to be overridden too or help still wins.
nnoremap <silent> <Help>      :call ToggleCheatsheet()<CR>
xnoremap <silent> <Help> <Esc>:call ToggleCheatsheet()<CR>
inoremap <silent> <Help> <C-o>:call ToggleCheatsheet()<CR>
" If the terminal sends a sequence vim has no F1 code for, the mapping never
" matches and the built-in help wins. \e O P is what mintty, Windows Terminal
" and xterm send; teach vim that only when it has nothing already.
if !has('gui_running') && &term !=# 'win32' && &t_k1 ==# ''
    execute "set <F1>=\<Esc>OP"
endif
nnoremap <silent> <leader>c   :call ToggleCheatsheet()<CR>

" Blockwise visual mode. Windows terminals swallow Ctrl+V for paste before
" vim ever sees it, so bind two fallbacks: Ctrl+Q (the traditional one — needs
" `stty -ixon` in Git Bash, where it is otherwise XON flow control) and
" <leader>v, which nothing else can intercept.
nnoremap <C-q> <C-v>
xnoremap <C-q> <C-v>
nnoremap <leader>v <C-v>
xnoremap <leader>v <C-v>
